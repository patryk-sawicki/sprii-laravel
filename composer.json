{
  "name": "patryk-sawicki/sprii-laravel",
  "description": "Sprii API client for laravel.",
  "license": "MIT",
  "authors": [
    {
      "name": "Patryk Sawicki",
      "email": "patryk.sawicki@decocode.pl"
    }
  ],
  "autoload": {
    "psr-4": {
      "PatrykSawicki\\SpriiApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PatrykSawicki\\SpriiTests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-simplexml": "*",
    "laravel/framework": "^10.00 || ^11.00"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "laravel/laravel": "^10.00 || ^11.00"
  },
  "extra": {
    "laravel": {
      "providers": [
        "PatrykSawicki\\SpriiApi\\app\\Providers\\SpriiServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  }
}
